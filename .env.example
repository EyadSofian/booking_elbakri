# ---------------------------------------------------------------------------
# ELBAKRI OVERSEAS — Operations OS
# Copy to .env and fill in. Never commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://elbakri:elbakri@localhost:5432/elbakri_operations?schema=public

# --- API -------------------------------------------------------------------
PORT=4000

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

CORS_ORIGINS=http://localhost:3000

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=10

STORAGE_ROOT=./storage
MAX_UPLOAD_MB=25

LOG_LEVEL=info
SWAGGER_ENABLED=true
APP_TIMEZONE=Africa/Cairo

# Used only by `npm run seed` to create the first Super Admin.
SEED_ADMIN_EMAIL=admin@elbakri.local
SEED_ADMIN_PASSWORD=ChangeMe!2026Elbakri

# --- Web -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Hotel directory integration (ELBAKRI Rate Hub)
#
# Server-to-server only. The browser never calls the Rate Hub, so these must
# never be exposed as NEXT_PUBLIC_* or reach the client bundle.
#
# The key is a dedicated integration credential, not an employee's session
# token: synchronisation runs on a schedule and must not depend on someone
# being logged in.
# ---------------------------------------------------------------------------
ELBAKRI_RATE_API_URL=https://rates.example.com
ELBAKRI_RATE_INTEGRATION_KEY=
