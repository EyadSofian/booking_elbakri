// ELBAKRI OVERSEAS — bookings for sales and operations.
//
// Kept deliberately small: one table per thing a person actually records.
//   Sale          — a customer booking with its prices (the sales sheet)
//   HotelBooking  — the operations hotel sheet
//   Transfer      — the operations transfer sheet (one row per journey)
//   Excursion     — the operations excursion sheet (one row per activity)
//   Visa          — the operations visa sheet
// Agencies and hotels are simple pick-lists. Every change lands in Activity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  OPERATIONS
}

enum Status {
  NEW
  IN_PROGRESS
  CONFIRMED
  DONE
  CANCELLED
}

enum Currency {
  EGP
  USD
  EUR
  SAR
}

enum TransferKind {
  ARRIVAL
  DEPARTURE
  TRANSFER
}

// ---------------------------------------------------------------------------
// People and sign-in
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(OPERATIONS)
  /// A sales supervisor sees every salesperson's sales; other salespeople see only their own.
  seesAllSales Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions          Session[]
  salesAsSeller     Sale[]         @relation("SaleSeller")
  salesCreated      Sale[]         @relation("SaleCreatedBy")
  paymentsCreated   SalePayment[]
  hotelsCreated     HotelBooking[]
  transfersCreated  Transfer[]
  excursionsCreated Excursion[]
  visasCreated      Visa[]
  activities        Activity[]
  imports           ImportBatch[]

  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  userAgent        String?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Pick-lists
// ---------------------------------------------------------------------------

/// Who the booking came from: a partner agency (SAMA, Tazkara, Yellow…) or
/// ELBAKRI's own customers (isDirect).
model Agency {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isDirect  Boolean  @default(false)
  phone     String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotelBookings HotelBooking[]
  transfers     Transfer[]
  excursions    Excursion[]
  visas         Visa[]

  @@map("agencies")
}

model Hotel {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  city      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings HotelBooking[]

  @@map("hotels")
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

/// One row of the sales sheet. Profit, commission and the customer balance are
/// always calculated from these figures — never typed.
model Sale {
  id           String    @id @default(uuid()) @db.Uuid
  number       Int       @unique @default(autoincrement())
  status       Status    @default(NEW)
  /// The day the sale was made (sheet: none — defaults to the day it is entered).
  saleDate     DateTime  @db.Date
  customerName String
  nationality  String?
  phone        String?
  destination  String?
  hotelName    String?
  adults       Int       @default(1)
  children     Int       @default(0)
  singleRooms  Int       @default(0)
  doubleRooms  Int       @default(0)
  tripleRooms  Int       @default(0)
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  currency     Currency  @default(EGP)

  hotelCost        Decimal @default(0) @db.Decimal(12, 2)
  hotelSell        Decimal @default(0) @db.Decimal(12, 2)
  flightDetails    String?
  flightCost       Decimal @default(0) @db.Decimal(12, 2)
  flightSell       Decimal @default(0) @db.Decimal(12, 2)
  flightCommission Decimal @default(0) @db.Decimal(12, 2)
  transferDetails  String?
  transferCost     Decimal @default(0) @db.Decimal(12, 2)
  transferSell     Decimal @default(0) @db.Decimal(12, 2)
  serviceType      String?
  serviceCost      Decimal @default(0) @db.Decimal(12, 2)
  serviceSell      Decimal @default(0) @db.Decimal(12, 2)

  sellerId       String?  @db.Uuid
  seller         User?    @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  commissionRate Decimal  @default(10) @db.Decimal(5, 2)
  notes          String?
  sourceKey      String?  @unique
  createdById    String?  @db.Uuid
  createdBy      User?    @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  payments      SalePayment[]
  hotelBookings HotelBooking[]
  transfers     Transfer[]
  excursions    Excursion[]
  visas         Visa[]

  @@index([status])
  @@index([saleDate])
  @@index([startDate])
  @@index([sellerId])
  @@index([deletedAt])
  @@map("sales")
}

model SalePayment {
  id          String   @id @default(uuid()) @db.Uuid
  saleId      String   @db.Uuid
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  paidOn      DateTime @db.Date
  method      String?
  note        String?
  createdById String?  @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([saleId])
  @@map("sale_payments")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

model HotelBooking {
  id             String    @id @default(uuid()) @db.Uuid
  number         Int       @unique @default(autoincrement())
  status         Status    @default(NEW)
  guestName      String
  nationality    String?
  phone          String?
  agencyId       String?   @db.Uuid
  agency         Agency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  hotelId        String?   @db.Uuid
  hotel          Hotel?    @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  checkIn        DateTime? @db.Date
  checkOut       DateTime? @db.Date
  rooms          String?
  mealPlan       String?
  adults         Int?
  children       Int?
  bookingDate    DateTime? @db.Date
  confirmationNo String?
  currency       Currency  @default(EGP)
  /// What ELBAKRI pays the hotel (the payment sheet's TOTAL PAYMENT).
  cost           Decimal?  @db.Decimal(12, 2)
  sell           Decimal?  @db.Decimal(12, 2)
  paidToHotel    Decimal?  @db.Decimal(12, 2)
  hotelPaidOn    DateTime? @db.Date
  notes          String?
  saleId         String?   @db.Uuid
  sale           Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  sourceKey      String?   @unique
  createdById    String?   @db.Uuid
  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([checkIn])
  @@index([checkOut])
  @@index([status])
  @@index([agencyId])
  @@index([hotelId])
  @@index([saleId])
  @@index([deletedAt])
  @@map("hotel_bookings")
}

model Transfer {
  id          String       @id @default(uuid()) @db.Uuid
  number      Int          @unique @default(autoincrement())
  status      Status       @default(NEW)
  kind        TransferKind @default(TRANSFER)
  guestName   String
  nationality String?
  phone       String?
  agencyId    String?      @db.Uuid
  agency      Agency?      @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  date        DateTime?    @db.Date
  /// Pickup time as HH:mm.
  time        String?
  fromPlace   String?
  toPlace     String?
  flightNo    String?
  adults      Int?
  children    Int?
  vehicle     String?
  driverName  String?
  driverPhone String?
  currency    Currency     @default(EGP)
  cost        Decimal?     @db.Decimal(12, 2)
  sell        Decimal?     @db.Decimal(12, 2)
  notes       String?
  saleId      String?      @db.Uuid
  sale        Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  sourceKey   String?      @unique
  createdById String?      @db.Uuid
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([date])
  @@index([status])
  @@index([agencyId])
  @@index([saleId])
  @@index([deletedAt])
  @@map("transfers")
}

model Excursion {
  id          String    @id @default(uuid()) @db.Uuid
  number      Int       @unique @default(autoincrement())
  status      Status    @default(NEW)
  guestName   String
  nationality String?
  phone       String?
  agencyId    String?   @db.Uuid
  agency      Agency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  activity    String
  hotelName   String?
  date        DateTime? @db.Date
  time        String?
  adults      Int?
  children    Int?
  currency    Currency  @default(EGP)
  cost        Decimal?  @db.Decimal(12, 2)
  sell        Decimal?  @db.Decimal(12, 2)
  notes       String?
  saleId      String?   @db.Uuid
  sale        Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  sourceKey   String?   @unique
  createdById String?   @db.Uuid
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([date])
  @@index([status])
  @@index([agencyId])
  @@index([saleId])
  @@index([deletedAt])
  @@map("excursions")
}

model Visa {
  id          String    @id @default(uuid()) @db.Uuid
  number      Int       @unique @default(autoincrement())
  status      Status    @default(NEW)
  guestName   String
  nationality String?
  phone       String?
  agencyId    String?   @db.Uuid
  agency      Agency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  pax         Int       @default(1)
  fromPlace   String?
  toPlace     String?
  travelDate  DateTime? @db.Date
  passportNo  String?
  currency    Currency  @default(USD)
  /// The visa sheet's NET.
  cost        Decimal?  @db.Decimal(12, 2)
  /// The visa sheet's SELL.
  sell        Decimal?  @db.Decimal(12, 2)
  notes       String?
  saleId      String?   @db.Uuid
  sale        Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  sourceKey   String?   @unique
  createdById String?   @db.Uuid
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([travelDate])
  @@index([status])
  @@index([agencyId])
  @@index([saleId])
  @@index([deletedAt])
  @@map("visas")
}

// ---------------------------------------------------------------------------
// History and imports
// ---------------------------------------------------------------------------

/// Who did what, on which record. Shown under every booking.
model Activity {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  summary    String?
  changes    Json?
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activities")
}

model ImportBatch {
  id        String   @id @default(uuid()) @db.Uuid
  fileName  String
  kind      String
  created   Int      @default(0)
  updated   Int      @default(0)
  skipped   Int      @default(0)
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@map("import_batches")
}
